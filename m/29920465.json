-side I>0 / I<0 filter could never agree. Lowered the agreement floor from 0 to −0.25 / +0.25 and required 2 agreeing snapshots instead of 3. That would have allowed 2 of T’s 3 live trades (the UP fill at I=−0.25 would still be blocked). Expected rate approaches T’s when the book is not strongly opposed (T’s 18-day backtest is ~10 trades/day / +$115 at $5; live T has been quieter)."}],"coinbase_lag":{"reachable":true,"samples":900,"last_price":58840.42,"last_diff_bp":0.9365,"mean_abs_bp":1.9904},"btc_minutes":{"as_of":"6:25:06 PM PT","source":"BRTI","last":58842.44,"series":[{"ts":1795224360,"t":"5:26 PM","c":58955.85,"d":-29.87,"dir":"down"},{"ts":1795224420,"t":"5:27 PM","c":58924.79,"d":-31.06,"dir":"down"},{"ts":1795224480,"t":"5:28 PM","c":58881.51,"d":-43.28,"dir":"down"},{"ts":1795224540,"t":"5:29 PM","c":58855.21,"d":-26.3,"dir":"down"},{"ts":1795224600,"t":"5:30 PM","c":58837.28,"d":-17.93,"dir":"down"},{"ts":1795224660,"t":"5:31 PM","c":58864.65,"d":27.37,"dir":"up"},{"ts":1795224720,"t":"5:32 PM","c":58851.27,"d":-13.38,"dir":"down"},{"ts":1795224780,"t":"5:33 PM","c":58817.09,"d":-34.18,"dir":"down"},{"ts":1795224840,"t":"5:34 PM","c":58807.92,"d":-9.17,"dir":"down"},{"ts":1795224900,"t":"5:35 PM","c":58778.16,"d":-29.76,"dir":"down"},{"ts":1795224960,"t":"5:36 PM","c":58800.12,"d":21.96,"dir":"up"},{"ts":1795225020,"t":"5:37 PM","c":58803.57,"d":3.45,"dir":"up"},{"ts":1795225080,"t":"5:38 PM","c":58823.41,"d":19.84,"dir":"up"},{"ts":1795225140,"t":"5:39 PM","c":58857.17,"d":33.76,"dir":"up"},{"ts":1795225200,"t":"5:40 PM","c":58852.68,"d":-4.49,"dir":"down"},{"ts":1795225260,"t":"5:41 PM","c":58885.47,"d":32.79,"dir":"up"},{"ts":1795225320,"t":"5:42 PM","c":58879.98,"d":-5.49,"dir":"down"},{"ts":1795225380,"t":"5:43 PM","c":58877.95,"d":-2.03,"dir":"down"},{"ts":1795225440,"t":"5:44 PM","c":58869.66,"d":-8.29,"dir":"down"},{"ts":1795225500,"t":"5:45 PM","c":58855.03,"d":-14.63,"dir":"down"},{"ts":1795225560,"t":"5:46 PM","c":58849.38,"d":-5.65,"dir":"do